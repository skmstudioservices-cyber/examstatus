---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HelpTip from '../../components/admin/HelpTip.astro';
import { getDb } from '../../lib/posts';
import { parseCookies, resolveAdmin } from '../../lib/auth';

export const prerender = false;

const db = getDb(Astro.locals);
if (!db) return Astro.redirect('/admin/login');
const cookies = parseCookies(Astro.request.headers.get('cookie'));
const user = await resolveAdmin(db, Astro.request, cookies['examstatus_session']);
if (!user) return Astro.redirect('/admin/login');

const postsCount = await db.prepare(`SELECT COUNT(*) as c FROM posts`).first();
const draftCount = await db.prepare(`SELECT COUNT(*) as c FROM posts WHERE status = 'draft'`).first();
const aiPending = await db.prepare(`SELECT COUNT(*) as c FROM ai_drafts WHERE status = 'pending'`).first();
const feedbackCount = await db.prepare(`SELECT COUNT(*) as c FROM feedback`).first();
const lastResearch = await db
  .prepare(`SELECT created_at, outcome FROM ai_run_logs ORDER BY created_at DESC LIMIT 1`)
  .first();
---

<AdminLayout user={user} title="Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-black">Dashboard</h1>
    <p class="text-sm text-slate-500">Welcome back. Here's a quick overview of your site.</p>
  </div>

  <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5 mb-6">
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <p class="flex items-center text-xs text-slate-500">
        Posts
        <HelpTip text="Total published and draft exam posts in the database." />
      </p>
      <p class="text-2xl font-black">{Number(postsCount?.c || 0)}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <p class="flex items-center text-xs text-slate-500">
        Drafts
        <HelpTip text="Posts saved as draft — not visible on the public site until published." />
      </p>
      <p class="text-2xl font-black">{Number(draftCount?.c || 0)}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <p class="flex items-center text-xs text-slate-500">
        AI pending
        <HelpTip text="AI-generated drafts waiting for review in the AI Inbox." />
      </p>
      <p class="text-2xl font-black">{Number(aiPending?.c || 0)}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <p class="flex items-center text-xs text-slate-500">
        Feedback
        <HelpTip text="User-submitted corrections or suggestions from the public site." />
      </p>
      <p class="text-2xl font-black">{Number(feedbackCount?.c || 0)}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm col-span-2 md:col-span-1">
      <p class="flex items-center text-xs text-slate-500">
        Last research
        <HelpTip text="Most recent AI research crawl — fetches official URLs and creates drafts." />
      </p>
      <p class="text-sm font-bold">
        {lastResearch?.created_at
          ? new Date(String(lastResearch.created_at)).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' })
          : 'Never'}
      </p>
      {lastResearch?.outcome && <p class="text-[10px] text-slate-400 uppercase">{lastResearch.outcome}</p>}
    </div>
  </div>

  <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm mb-6">
    <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-slate-500">Quick actions</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/posts" class="rounded bg-amber-500 px-4 py-2 text-sm font-bold hover:bg-amber-600">Manage posts</a>
      <button id="seed-btn" type="button" class="rounded border bg-white px-4 py-2 text-sm font-bold hover:bg-slate-50">Seed from exams.json</button>
      <a href="/admin/ai" class="rounded border bg-white px-4 py-2 text-sm font-bold hover:bg-slate-50">AI Inbox</a>
      <a href="/admin/audit" class="rounded border bg-white px-4 py-2 text-sm font-bold hover:bg-slate-50">Run audit</a>
    </div>
    <p id="seed-msg" class="mt-3 text-xs text-slate-600"></p>
  </section>

  <section class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs text-amber-950">
    <p class="mb-1 flex items-center font-bold">
      Publish checklist
      <HelpTip text="All rules must pass before a post can go live. Validation runs on publish." />
    </p>
    <p>Unique summary (40+ chars) · ≥3 FAQ · ≥3 how-to steps · allowlisted official URL · paraphrase (no competitor copy)</p>
  </section>

  <script is:inline>
    document.getElementById('seed-btn')?.addEventListener('click', async () => {
      const msg = document.getElementById('seed-msg');
      msg.textContent = 'Seeding...';
      const res = await fetch('/api/admin/seed.json', { method: 'POST' });
      const data = await res.json();
      msg.textContent = res.ok ? `Seeded ${data.count} posts` : (data.error || 'Failed');
    });
  </script>
</AdminLayout>
