# Copy to .env for local Astro (optional). Never commit real values.
# PUBLIC_SITE_URL=http://localhost:4321

# Admin session signing (production: use `wrangler secret put ADMIN_SESSION_SECRET`)
# ADMIN_SESSION_SECRET=generate-a-long-random-string

# Cron/research API auth (production: use `wrangler secret put AI_CRON_SECRET`)
# AI_CRON_SECRET=generate-a-long-random-string
