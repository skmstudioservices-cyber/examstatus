---
import ExamLayout from '../../layouts/ExamLayout.astro';
import { getDb } from '../../lib/posts';
import { loadPublished } from '../../lib/load';
import { getThemeSettings, cacheHeaders } from '../../lib/settings';
import { DEFAULT_THEME } from '../../lib/types';
import { getLang, pickLang } from '../../lib/i18n';

export const prerender = false;

const { slug } = Astro.params;
const label = (slug || '').replace(/-/g, ' ');
const db = getDb(Astro.locals);
const theme = db ? await getThemeSettings(db) : DEFAULT_THEME;
const lang = getLang(Astro.url, Astro.request.headers.get('cookie'));
const all = await loadPublished(db);
const posts = all.filter((p) =>
  p.qualifications.some((q) => q.toLowerCase().replace(/\s+/g, '-') === slug || q.toLowerCase() === label)
);
Astro.response.headers.set('Cache-Control', cacheHeaders(theme.cacheTtlSeconds)['Cache-Control'] as string);
---

<ExamLayout
  title={`${label} jobs | ExamStatus`}
  description={`Government exams suitable for ${label} qualification.`}
  theme={theme}
  lang={lang}
>
  <div class="bg-white rounded-lg shadow p-5 sm:p-6">
    <h1 class="text-2xl font-black capitalize mb-2">{label} eligibility</h1>
    <p class="text-sm text-gray-600 mb-6">Posts tagged for this qualification filter. Confirm exact eligibility in the official PDF.</p>
    <ul class="divide-y">
      {posts.map((p) => (
        <li class="py-3">
          <a href={`/exam/${p.slug}?lang=${lang}`} class="font-bold text-sm hover:text-amber-700">{pickLang(p.title, p.title_hi, lang)}</a>
        </li>
      ))}
      {posts.length === 0 && <li class="py-6 text-sm text-gray-500">No matching posts yet.</li>}
    </ul>
  </div>
</ExamLayout>
