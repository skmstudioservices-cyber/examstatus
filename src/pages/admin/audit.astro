---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HelpTip from '../../components/admin/HelpTip.astro';
import { getDb } from '../../lib/posts';
import { parseCookies, resolveAdmin } from '../../lib/auth';

export const prerender = false;

const db = getDb(Astro.locals);
if (!db) return Astro.redirect('/admin/login');
const cookies = parseCookies(Astro.request.headers.get('cookie'));
const user = await resolveAdmin(db, Astro.request, cookies['examstatus_session']);
if (!user) return Astro.redirect('/admin/login');

const findings = await db
  .prepare(`SELECT * FROM audit_findings WHERE status = 'open' ORDER BY CASE severity WHEN 'high' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END, created_at DESC LIMIT 100`)
  .all();

const severityColor: Record<string, string> = {
  high: 'bg-red-100 text-red-700 border-red-300',
  medium: 'bg-amber-100 text-amber-700 border-amber-300',
  low: 'bg-slate-100 text-slate-600 border-slate-300',
};
---

<AdminLayout user={user} title="Site Audit" breadcrumbs={[{ label: 'Site Audit' }]}>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="flex items-center text-xl font-bold text-[#1d2327]">
        Site Audit & Health
        <HelpTip text="AI reads your page HTML for SEO gaps, missing alt text, broken headings, thin content, and mobile layout issues. Read-only — nothing auto-fixes." />
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">Automated quality check for SEO, broken links, accessibility, and content completeness.</p>
    </div>
    <button id="run-audit-btn" class="rounded bg-[#2271b1] px-4 py-2 text-xs font-bold text-white hover:bg-[#135e96] transition shadow-sm">Run Audit Now</button>
  </div>
  <p id="audit-status" class="mb-3 text-xs font-semibold"></p>

  {findings.results.length === 0 && (
    <div class="rounded border border-[#c3c4c7] bg-white p-8 text-center text-xs text-slate-500 shadow-sm">
      No open findings. Click "Run Audit Now" to check your published exam pages.
    </div>
  )}

  <div class="space-y-3">
    {findings.results.map((f: any) => (
      <div class="flex items-start justify-between gap-3 rounded border border-[#c3c4c7] bg-white p-4 shadow-sm">
        <div class="min-w-0">
          <div class="mb-1 flex flex-wrap items-center gap-2">
            <span class={`rounded border px-2 py-0.5 text-[10px] font-bold uppercase ${severityColor[f.severity] || severityColor.low}`}>{f.severity}</span>
            <span class="text-[10px] font-bold uppercase text-gray-400">{f.category}</span>
            <span class="text-[10px] text-gray-400">{f.page_path}</span>
          </div>
          <p class="text-sm text-gray-800">{f.finding}</p>
          {f.suggestion && <p class="mt-1 text-xs text-gray-500">Suggested fix: {f.suggestion}</p>}
        </div>
        <div class="flex shrink-0 flex-col gap-1">
          <button class="resolve-btn text-xs font-bold text-green-600 hover:text-green-800" data-id={f.id}>Resolve</button>
          <button class="dismiss-btn text-xs font-bold text-gray-400 hover:text-gray-600" data-id={f.id}>Dismiss</button>
        </div>
      </div>
    ))}
  </div>

  <script is:inline>
    document.getElementById('run-audit-btn').addEventListener('click', async (e) => {
      const btn = e.target;
      const status = document.getElementById('audit-status');
      btn.disabled = true;
      btn.textContent = 'Running... (takes ~10-20s)';
      status.textContent = '';
      try {
        const res = await fetch('/api/admin/run-audit.json', { method: 'POST' });
        const data = await res.json();
        if (res.ok) {
          status.textContent = `Done \u2014 checked ${data.pagesChecked} pages, found ${data.totalFindings} new item(s). Refreshing...`;
          status.className = 'text-xs mb-3 text-green-600 font-semibold';
          setTimeout(() => location.reload(), 1200);
        } else {
          status.textContent = data.error || 'Audit failed';
          status.className = 'text-xs mb-3 text-red-600 font-semibold';
        }
      } catch (err) {
        status.textContent = 'Network error';
        status.className = 'text-xs mb-3 text-red-600 font-semibold';
      }
      btn.disabled = false;
      btn.textContent = 'Run audit now';
    });

    async function updateStatus(id, status) {
      await fetch('/api/admin/audit-status.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status }),
      });
      location.reload();
    }
    document.querySelectorAll('.resolve-btn').forEach((b) => b.addEventListener('click', () => updateStatus(b.dataset.id, 'resolved')));
    document.querySelectorAll('.dismiss-btn').forEach((b) => b.addEventListener('click', () => updateStatus(b.dataset.id, 'dismissed')));
  </script>
</AdminLayout>
