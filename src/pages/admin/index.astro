---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HelpTip from '../../components/admin/HelpTip.astro';
import { getDb } from '../../lib/posts';
import { parseCookies, resolveAdmin } from '../../lib/auth';

export const prerender = false;

const db = getDb(Astro.locals);
if (!db) return Astro.redirect('/admin/login');
const cookies = parseCookies(Astro.request.headers.get('cookie'));
const user = await resolveAdmin(db, Astro.request, cookies['examstatus_session']);
if (!user) return Astro.redirect('/admin/login');

const postsCount = await db.prepare(`SELECT COUNT(*) as c FROM posts`).first();
const draftCount = await db.prepare(`SELECT COUNT(*) as c FROM posts WHERE status = 'draft'`).first();
const publishedCount = await db.prepare(`SELECT COUNT(*) as c FROM posts WHERE status = 'published'`).first();
const aiPending = await db.prepare(`SELECT COUNT(*) as c FROM ai_drafts WHERE status = 'pending'`).first();
const feedbackCount = await db.prepare(`SELECT COUNT(*) as c FROM feedback`).first();
const lastResearch = await db
  .prepare(`SELECT created_at, outcome FROM ai_run_logs ORDER BY created_at DESC LIMIT 1`)
  .first();

const { results: recentPosts = [] } = await db
  .prepare(`SELECT slug, title, category, status, updated_at FROM posts ORDER BY updated_at DESC LIMIT 5`)
  .all();
---

<AdminLayout user={user} title="Dashboard">
  <!-- Page Header -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <div>
      <h1 class="text-xl font-bold text-[#1d2327]">Dashboard</h1>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="/admin/posts?action=new"
        class="inline-flex items-center gap-1.5 rounded bg-[#2271b1] px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-[#135e96] transition"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
        <span>Add New Post</span>
      </a>
    </div>
  </div>

  <!-- WordPress Welcome Hero Panel -->
  <div id="wp-welcome-panel" class="mb-6 rounded border border-[#c3c4c7] bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-[#1d2327]">Welcome to ExamStatus!</h2>
        <p class="mt-1 text-xs text-slate-600">We've assembled some links to get you started with managing your exam portal:</p>
      </div>
    </div>
    <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-3 border-t border-slate-100 pt-4 text-xs">
      <div>
        <h3 class="font-bold text-slate-800 text-[13px] mb-2">Get Started</h3>
        <a
          href="/admin/posts?action=new"
          class="inline-block rounded bg-[#2271b1] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#135e96] mb-2 shadow-sm"
        >
          Write your first post
        </a>
        <p class="text-slate-500 text-[12px]">or <a href="/admin/posts" class="text-[#2271b1] hover:underline">manage existing posts</a></p>
      </div>
      <div>
        <h3 class="font-bold text-slate-800 text-[13px] mb-2">Next Steps</h3>
        <ul class="space-y-1.5 text-slate-600">
          <li>
            <a href="/admin/ai" class="flex items-center gap-1.5 text-[#2271b1] hover:underline">
              <span>⚡</span> Review AI Inbox drafts ({Number(aiPending?.c || 0)})
            </a>
          </li>
          <li>
            <button id="seed-btn" type="button" class="flex items-center gap-1.5 text-[#2271b1] hover:underline text-left">
              <span>🌱</span> Seed database from exams.json
            </button>
            <span id="seed-msg" class="block text-[11px] text-slate-500 italic"></span>
          </li>
          <li>
            <a href="/admin/theme" class="flex items-center gap-1.5 text-[#2271b1] hover:underline">
              <span>🎨</span> Customize site appearance & colors
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-bold text-slate-800 text-[13px] mb-2">More Actions</h3>
        <ul class="space-y-1.5 text-slate-600">
          <li>
            <a href="/admin/audit" class="flex items-center gap-1.5 text-[#2271b1] hover:underline">
              <span>🔍</span> Run SEO & quality audit
            </a>
          </li>
          <li>
            <a href="/admin/team" class="flex items-center gap-1.5 text-[#2271b1] hover:underline">
              <span>👥</span> Manage team roles
            </a>
          </li>
          <li>
            <a href="/" target="_blank" rel="noopener" class="flex items-center gap-1.5 text-[#2271b1] hover:underline">
              <span>↗</span> View live site
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- 2-Column WordPress Dashboard Widgets Grid -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Left Column -->
    <div class="space-y-6">
      <!-- At a Glance Widget -->
      <div class="rounded border border-[#c3c4c7] bg-white shadow-sm">
        <div class="border-b border-[#c3c4c7] bg-[#f6f7f7] px-4 py-2.5">
          <h2 class="text-[13px] font-bold text-[#1d2327] flex items-center justify-between">
            <span>At a Glance</span>
            <HelpTip text="Summary of posts and system content in your database." />
          </h2>
        </div>
        <div class="p-4">
          <div class="grid grid-cols-2 gap-4 pb-4 border-b border-slate-100 text-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  Total Posts
                </span>
                <a href="/admin/posts" class="font-bold text-[#2271b1] hover:underline">{Number(postsCount?.c || 0)}</a>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                  Published
                </span>
                <span class="font-semibold text-emerald-700">{Number(publishedCount?.c || 0)}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                  Drafts
                </span>
                <span class="font-semibold text-amber-700">{Number(draftCount?.c || 0)}</span>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  AI Pending
                </span>
                <a href="/admin/ai" class="font-bold text-amber-600 hover:underline">{Number(aiPending?.c || 0)}</a>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
                  Feedback
                </span>
                <span class="font-semibold text-slate-700">{Number(feedbackCount?.c || 0)}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-blue-500 inline-block"></span>
                  Database
                </span>
                <span class="font-mono text-[11px] text-slate-500">Cloudflare D1</span>
              </div>
            </div>
          </div>
          <div class="pt-3 text-[11px] text-slate-500 flex items-center justify-between">
            <span>ExamStatus Running on Cloudflare Workers</span>
            <span>SSR Mode</span>
          </div>
        </div>
      </div>

      <!-- Activity Widget -->
      <div class="rounded border border-[#c3c4c7] bg-white shadow-sm">
        <div class="border-b border-[#c3c4c7] bg-[#f6f7f7] px-4 py-2.5">
          <h2 class="text-[13px] font-bold text-[#1d2327]">Activity</h2>
        </div>
        <div class="p-4">
          <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Recently Published & Modified</h3>
          {recentPosts.length > 0 ? (
            <div class="divide-y divide-slate-100 text-xs">
              {recentPosts.map((p: any) => (
                <div class="py-2.5 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <a href={`/admin/posts?slug=${p.slug}`} class="font-semibold text-[#2271b1] hover:underline truncate block">
                      {p.title}
                    </a>
                    <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-500">
                      <span class="capitalize">{p.category}</span>
                      <span>·</span>
                      <span>{p.updated_at ? new Date(p.updated_at).toLocaleDateString('en-IN') : 'Recently'}</span>
                    </div>
                  </div>
                  <div class="shrink-0 flex items-center gap-2">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      p.status === 'published'
                        ? 'bg-emerald-100 text-emerald-800'
                        : 'bg-amber-100 text-amber-800'
                    }`}>
                      {p.status}
                    </span>
                    <a
                      href={`/admin/posts?slug=${p.slug}`}
                      class="text-[11px] text-[#2271b1] hover:underline"
                    >
                      Edit
                    </a>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-xs text-slate-500 italic py-2">No posts found. Seed or create your first post!</p>
          )}
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="space-y-6">
      <!-- Quick Draft Widget (Iconic WordPress Feature) -->
      <div class="rounded border border-[#c3c4c7] bg-white shadow-sm">
        <div class="border-b border-[#c3c4c7] bg-[#f6f7f7] px-4 py-2.5">
          <h2 class="text-[13px] font-bold text-[#1d2327]">Quick Draft</h2>
        </div>
        <form id="quick-draft-form" class="p-4 space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Title</label>
            <input
              id="qd-title"
              name="title"
              required
              placeholder="e.g. UPSC Civil Services 2026 Notification"
              class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none focus:ring-1 focus:ring-[#2271b1]"
            />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Category</label>
              <select
                id="qd-category"
                name="category"
                class="w-full rounded border border-slate-300 px-2 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none"
              >
                <option value="latest-jobs">Latest Jobs</option>
                <option value="admit-cards">Admit Cards</option>
                <option value="results">Results</option>
                <option value="answer-keys">Answer Keys</option>
                <option value="syllabus">Syllabus</option>
                <option value="admissions">Admissions</option>
                <option value="scholarships">Scholarships</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Organization</label>
              <input
                id="qd-org"
                name="organization"
                placeholder="e.g. UPSC"
                class="w-full rounded border border-slate-300 px-2 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none"
              />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Quick Summary / Notes</label>
            <textarea
              id="qd-summary"
              name="summary"
              rows="3"
              placeholder="What's on your mind? Briefly summarize the exam or notification..."
              class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none focus:ring-1 focus:ring-[#2271b1]"
            ></textarea>
          </div>
          <div class="flex items-center justify-between pt-1">
            <button
              type="submit"
              id="qd-submit"
              class="rounded bg-[#f6f7f7] border border-[#2271b1] text-[#2271b1] px-3 py-1.5 text-xs font-semibold hover:bg-[#2271b1] hover:text-white transition cursor-pointer"
            >
              Save Draft
            </button>
            <span id="qd-msg" class="text-xs text-slate-600"></span>
          </div>
        </form>
      </div>

      <!-- AI Research & System Status Widget -->
      <div class="rounded border border-[#c3c4c7] bg-white shadow-sm">
        <div class="border-b border-[#c3c4c7] bg-[#f6f7f7] px-4 py-2.5 flex items-center justify-between">
          <h2 class="text-[13px] font-bold text-[#1d2327]">AI Discovery & Crawl</h2>
          <span class="text-[11px] font-mono text-slate-500">Hourly Cron</span>
        </div>
        <div class="p-4 space-y-3 text-xs">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="text-slate-600">Last Discovery Run:</span>
            <span class="font-semibold text-slate-800">
              {lastResearch?.created_at
                ? new Date(String(lastResearch.created_at)).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' })
                : 'Never'}
            </span>
          </div>
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="text-slate-600">Outcome Status:</span>
            <span class="font-bold uppercase text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-700">
              {lastResearch?.outcome || 'Idle'}
            </span>
          </div>
          <p class="text-[11px] text-slate-500 leading-relaxed">
            AI research automatically scans official SSC, UPSC, RRB, and NTA portals every 3–9 hours and deposits draft updates in the AI Inbox for your review before publishing.
          </p>
          <div class="pt-2 flex items-center gap-2">
            <a
              href="/admin/ai"
              class="rounded bg-[#2271b1] text-white px-3 py-1.5 text-xs font-semibold hover:bg-[#135e96] transition"
            >
              Open AI Inbox
            </a>
            <a
              href="/admin/audit"
              class="rounded border border-slate-300 bg-white text-slate-700 px-3 py-1.5 text-xs font-semibold hover:bg-slate-50 transition"
            >
              Site Audit
            </a>
          </div>
        </div>
      </div>

      <!-- Publish Rules Notice Box -->
      <div class="rounded border-l-4 border-l-[#72aee6] border border-[#c3c4c7] bg-[#f0f6fc] p-4 text-xs text-slate-700 shadow-sm">
        <h3 class="font-bold text-[#1d2327] mb-1 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#2271b1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Publish Checklist Rules
        </h3>
        <p class="text-[12px] text-slate-600">
          Before a post can be published live: summary must be ≥40 characters, FAQs must have ≥3 items, how-to-apply steps must be provided, and official URLs must be on allowlisted government domains.
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    // Seeding action
    document.getElementById('seed-btn')?.addEventListener('click', async () => {
      const msg = document.getElementById('seed-msg');
      if (msg) msg.textContent = 'Seeding from exams.json...';
      try {
        const res = await fetch('/api/admin/seed.json', { method: 'POST' });
        const data = await res.json();
        if (msg) msg.textContent = res.ok ? `Seeded ${data.count} posts successfully!` : (data.error || 'Seeding failed');
        if (res.ok) setTimeout(() => location.reload(), 1200);
      } catch (err) {
        if (msg) msg.textContent = 'Error during seeding';
      }
    });

    // Quick Draft action
    document.getElementById('quick-draft-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const title = form.title.value.trim();
      const category = form.category.value;
      const org = form.organization.value.trim();
      const summary = form.summary.value.trim();
      const msg = document.getElementById('qd-msg');

      if (!title) return;
      if (msg) msg.textContent = 'Saving draft...';

      // Auto-generate slug from title
      const slug = title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '') + '-' + Date.now().toString().slice(-4);

      try {
        const res = await fetch('/api/admin/posts.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug,
            title,
            category,
            organization: org,
            summary,
            status: 'draft',
            level: 'national'
          })
        });
        const data = await res.json();
        if (res.ok) {
          if (msg) msg.textContent = 'Draft saved! Redirecting...';
          setTimeout(() => {
            location.href = `/admin/posts?slug=${encodeURIComponent(slug)}`;
          }, 800);
        } else {
          if (msg) msg.textContent = data.error || 'Failed to save';
        }
      } catch (err) {
        if (msg) msg.textContent = 'Network error saving draft';
      }
    });
  </script>
</AdminLayout>
