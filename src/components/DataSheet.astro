---
export interface Props {
  organization: string;
  postName: string;
  totalVacancies: number | string;
  startDate: string;
  closingDate: string;
  examDate?: string;
  admitCardDate?: string;
  fees: { category: string; amount: string }[];
  minAge?: string;
  maxAge?: string;
  eligibility: { postName: string; totalPosts: string; qualification: string }[];
  applyOnlineUrl?: string;
  notificationPdfUrl?: string;
  officialUrl?: string;
}

const {
  organization,
  postName,
  totalVacancies,
  startDate,
  closingDate,
  examDate = 'Notified Soon',
  admitCardDate = 'Before Exam',
  fees = [],
  minAge = '18 Years',
  maxAge = '32 Years',
  eligibility = [],
  applyOnlineUrl = 'https://ssc.gov.in',
  notificationPdfUrl = 'https://ssc.gov.in',
  officialUrl = 'https://ssc.gov.in'
} = Astro.props;
---

<div class="border-2 border-red-700 bg-white rounded-lg shadow-md overflow-hidden text-sm my-6">
  <div class="bg-red-800 text-white p-4 text-center">
    <h2 class="text-xl md:text-2xl font-black uppercase tracking-tight">{organization}</h2>
    <p class="text-amber-300 font-bold text-base md:text-lg mt-1">{postName} Recruitment 2026</p>
    <div class="inline-block bg-amber-500 text-slate-950 font-black px-4 py-1 rounded-full text-xs uppercase mt-2 shadow">
      Total Vacancies: {totalVacancies} Posts
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-red-200 bg-red-50">
    <div class="p-4">
      <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
        📅 Important Dates
      </h3>
      <ul class="space-y-2 text-xs md:text-sm">
        <li class="flex justify-between py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Application Start:</span>
          <span class="font-bold text-green-700">{startDate}</span>
        </li>
        <li class="flex justify-between py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Last Date to Apply:</span>
          <span class="font-bold text-red-700">{closingDate}</span>
        </li>
        <li class="flex justify-between py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Exam Date:</span>
          <span class="font-bold text-blue-800">{examDate}</span>
        </li>
        <li class="flex justify-between py-1">
          <span class="font-semibold text-gray-700">Admit Card:</span>
          <span class="font-bold text-purple-700">{admitCardDate}</span>
        </li>
      </ul>
    </div>

    <div class="p-4">
      <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
        💳 Application Fee Structure
      </h3>
      <ul class="space-y-2 text-xs md:text-sm">
        {fees.map(f => (
          <li class="flex justify-between py-1 border-b border-red-100">
            <span class="font-semibold text-gray-700">{f.category}:</span>
            <span class="font-bold text-gray-900">{f.amount}</span>
          </li>
        ))}
      </ul>
      <div class="mt-3 p-2 bg-white rounded border border-red-200 text-xs text-gray-600">
        <strong class="text-red-700">Payment Mode:</strong> Online via Net Banking, Debit Card, UPI
      </div>
    </div>
  </div>

  <div class="p-4 border-t-2 border-red-200 bg-white">
    <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-2 uppercase text-center bg-red-100 py-1 text-xs">
      ⏳ Age Limit Criteria (As On 01/08/2026)
    </h3>
    <div class="flex justify-around text-xs md:text-sm font-semibold py-1 text-gray-800">
      <div>Min Age: <span class="text-red-700 font-bold">{minAge}</span></div>
      <div>Max Age: <span class="text-red-700 font-bold">{maxAge}</span></div>
    </div>
  </div>

  <div class="p-4 border-t-2 border-red-200 bg-gray-50">
    <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
      🎓 Vacancy & Eligibility Details
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse border border-gray-300 text-xs md:text-sm">
        <thead>
          <tr class="bg-red-800 text-white font-bold">
            <th class="p-2 border border-gray-300">Post Name</th>
            <th class="p-2 border border-gray-300 text-center">Total Posts</th>
            <th class="p-2 border border-gray-300">Minimum Qualification</th>
          </tr>
        </thead>
        <tbody>
          {eligibility.map((item, idx) => (
            <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-red-50/50'}>
              <td class="p-2 border border-gray-300 font-bold text-gray-800">{item.postName}</td>
              <td class="p-2 border border-gray-300 text-center font-extrabold text-red-700">{item.totalPosts}</td>
              <td class="p-2 border border-gray-300 text-gray-700">{item.qualification}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="p-4 border-t-4 border-red-600 bg-amber-50">
    <h3 class="font-black text-slate-900 text-sm md:text-base text-center uppercase mb-3">
      ⚡ Quick Action Important Links
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-center font-bold text-xs md:text-sm">
      <a href={applyOnlineUrl} target="_blank" class="bg-green-700 hover:bg-green-800 text-white py-3 px-4 rounded shadow">
        🚀 Apply Online (Registration / Login)
      </a>
      <a href={notificationPdfUrl} target="_blank" class="bg-red-700 hover:bg-red-800 text-white py-3 px-4 rounded shadow">
        📄 Download Official Notification PDF
      </a>
      <a href={officialUrl} target="_blank" class="bg-blue-700 hover:bg-blue-800 text-white py-3 px-4 rounded shadow">
        🌐 Official Authority Website
      </a>
      <a href="https://telegram.org" target="_blank" class="bg-sky-600 hover:bg-sky-700 text-white py-3 px-4 rounded shadow">
        ✈️ Join Telegram Fast Alert Group
      </a>
    </div>
  </div>
</div>
