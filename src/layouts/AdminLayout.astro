---
export const prerender = false;

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  user?: { email: string; role: string };
  title?: string;
  breadcrumbs?: Breadcrumb[];
}

const { user = { email: 'Admin', role: 'admin' }, title, breadcrumbs = [] } = Astro.props;
const path = Astro.url.pathname;

const navItems = [
  {
    href: '/admin',
    label: 'Dashboard',
    icon: 'dash',
    match: (p: string) => p === '/admin'
  },
  {
    href: '/admin/posts',
    label: 'Posts',
    icon: 'posts',
    match: (p: string) => p.startsWith('/admin/posts'),
    subItems: [
      { href: '/admin/posts', label: 'All Posts' },
      { href: '/admin/posts?action=new', label: 'Add New Post' }
    ]
  },
  {
    href: '/admin/ai',
    label: 'AI Automation',
    icon: 'ai',
    match: (p: string) => p === '/admin/ai'
  },
  {
    href: '/admin/ai-studio',
    label: 'AI Studio',
    icon: 'studio',
    match: (p: string) => p.startsWith('/admin/ai-studio')
  },
  {
    href: '/admin/theme',
    label: 'Appearance',
    icon: 'theme',
    match: (p: string) => p.startsWith('/admin/theme')
  },
  {
    href: '/admin/team',
    label: 'Users / Team',
    icon: 'team',
    match: (p: string) => p.startsWith('/admin/team')
  },
  {
    href: '/admin/audit',
    label: 'Site Audit',
    icon: 'audit',
    match: (p: string) => p.startsWith('/admin/audit')
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} ‹ ExamStatus Admin` : 'ExamStatus ‹ Administration'}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    }
    .wp-admin-bar {
      background-color: #1d2327;
      color: #c3c4c7;
      height: 32px;
    }
    .wp-sidebar {
      background-color: #1d2327;
      color: #f0f0f1;
    }
    .wp-nav-item:hover {
      background-color: #135e96;
      color: #72aee6;
    }
    .wp-nav-item.active {
      background-color: #2271b1;
      color: #ffffff;
      font-weight: 600;
    }
    @media (max-width: 767px) {
      #admin-sidebar.open { transform: translateX(0); }
      #admin-overlay.open { display: block; }
    }
  </style>
</head>
<body class="bg-[#f0f0f1] text-[#2c3338] min-h-screen text-[13px] antialiased flex flex-col">
  <!-- WordPress Admin Top Bar -->
  <header class="wp-admin-bar fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-3 text-[13px] border-b border-black/20 select-none">
    <div class="flex items-center space-x-1 sm:space-x-2">
      <button
        id="sidebar-toggle"
        type="button"
        class="md:hidden text-[#c3c4c7] hover:text-white p-1 rounded focus:outline-none"
        aria-label="Toggle navigation"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

      <a href="/admin" class="flex items-center gap-1.5 px-2 py-1 text-white font-semibold hover:bg-[#2c3338] hover:text-[#72aee6] rounded transition">
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        <span>ExamStatus</span>
      </a>

      <a
        href="/"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-[#c3c4c7] hover:bg-[#2c3338] hover:text-[#72aee6] rounded transition text-[12px]"
        title="View the public site"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        <span>Visit Site</span>
      </a>

      <div class="relative group hidden sm:block">
        <a href="/admin/posts?action=new" class="flex items-center gap-1 px-2 py-1 text-[#c3c4c7] hover:bg-[#2c3338] hover:text-[#72aee6] rounded text-[12px] transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
          <span>New Post</span>
        </a>
      </div>
    </div>

    <div class="flex items-center space-x-2 text-[12px]">
      <span class="text-[#c3c4c7] hidden md:inline">
        Howdy, <strong class="text-white">{user.email.split('@')[0]}</strong>
      </span>
      <span class="bg-[#2c3338] text-amber-300 font-mono text-[10px] px-1.5 py-0.5 rounded uppercase tracking-wider font-bold">
        {user.role}
      </span>
      <div class="w-5 h-5 rounded-full bg-slate-600 flex items-center justify-center text-white text-[10px] font-bold">
        {user.email.charAt(0).toUpperCase()}
      </div>
      <button
        id="logout-btn"
        type="button"
        class="text-[#c3c4c7] hover:text-rose-400 hover:bg-[#2c3338] px-2 py-1 rounded transition text-[12px] font-semibold"
      >
        Log Out
      </button>
    </div>
  </header>

  <div class="flex flex-1 pt-8 min-h-screen">
    <!-- Mobile overlay -->
    <div id="admin-overlay" class="fixed inset-0 z-30 hidden bg-black/50 md:hidden" aria-hidden="true"></div>

    <!-- Classic WordPress Sidebar -->
    <aside
      id="admin-sidebar"
      class="wp-sidebar fixed inset-y-0 left-0 top-8 z-40 flex w-48 -translate-x-full flex-col border-r border-[#1d2327] transition-transform md:static md:translate-x-0 select-none shadow-md"
    >
      <nav class="flex-1 overflow-y-auto pt-2 pb-6" aria-label="Admin navigation">
        {navItems.map((item) => {
          const active = item.match(path);
          return (
            <div class="group relative">
              <a
                href={item.href}
                class={`wp-nav-item flex items-center gap-2.5 px-3 py-2 text-[13px] transition-colors border-l-4 ${
                  active
                    ? 'active border-[#2271b1]'
                    : 'text-[#f0f0f1] border-transparent hover:text-[#72aee6]'
                }`}
              >
                {item.icon === 'dash' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                  </svg>
                )}
                {item.icon === 'posts' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                )}
                {item.icon === 'ai' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {item.icon === 'studio' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {item.icon === 'theme' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                )}
                {item.icon === 'team' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {item.icon === 'audit' && (
                  <svg class="h-4 w-4 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>

              {item.subItems && (
                <div class={`bg-[#2c3338] py-1 text-[12px] ${active ? 'block' : 'hidden md:group-hover:block md:absolute md:left-full md:top-0 md:w-36 md:shadow-lg md:border md:border-[#1d2327]'}`}>
                  {item.subItems.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-4 py-1 text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#1d2327]"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <div class="border-t border-[#2c3338] p-3 text-[11px] text-[#8c8f94] flex items-center justify-between">
        <span>ExamStatus</span>
        <span class="font-mono text-[10px]">v1.2</span>
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-w-0 flex-1 flex-col overflow-y-auto">
      <main class="flex-1 p-4 md:p-6 max-w-7xl w-full mx-auto">
        {breadcrumbs.length > 0 && (
          <nav class="mb-3 text-[12px] text-slate-500" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-1.5">
              <li><a href="/admin" class="hover:text-[#2271b1]">Dashboard</a></li>
              {breadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-slate-400" aria-hidden="true">›</span>
                  {crumb.href && i < breadcrumbs.length - 1 ? (
                    <a href={crumb.href} class="hover:text-[#2271b1]">{crumb.label}</a>
                  ) : (
                    <span class="font-semibold text-slate-700">{crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
      </main>

      <footer class="border-t border-[#c3c4c7]/40 bg-white/60 px-6 py-3 text-[11px] text-slate-500 flex flex-wrap items-center justify-between gap-2 mt-auto">
        <span>Thank you for creating with <strong class="text-slate-700">ExamStatus</strong>.</span>
        <span>Running on Cloudflare Workers + D1 Database</span>
      </footer>
    </div>
  </div>

  <script is:inline>
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('admin-overlay');
    const toggle = document.getElementById('sidebar-toggle');

    function closeSidebar() {
      sidebar?.classList.remove('open');
      overlay?.classList.remove('open');
    }
    function openSidebar() {
      sidebar?.classList.add('open');
      overlay?.classList.add('open');
    }

    toggle?.addEventListener('click', () => {
      if (sidebar?.classList.contains('open')) closeSidebar();
      else openSidebar();
    });
    overlay?.addEventListener('click', closeSidebar);

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/auth.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'logout' })
      });
      location.href = '/admin/login';
    });
  </script>
</body>
</html>
