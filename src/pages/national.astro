---
import ExamLayout from '../layouts/ExamLayout.astro';
import { getDb } from '../lib/posts';
import { loadPublished } from '../lib/load';
import { getThemeSettings, cacheHeaders } from '../lib/settings';
import { DEFAULT_THEME } from '../lib/types';
import { getLang, pickLang } from '../lib/i18n';

export const prerender = false;

const db = getDb(Astro.locals);
const theme = db ? await getThemeSettings(db) : DEFAULT_THEME;
const lang = getLang(Astro.url, Astro.request.headers.get('cookie'));
const posts = await loadPublished(db, { level: 'national' });
Astro.response.headers.set('Cache-Control', cacheHeaders(theme.cacheTtlSeconds)['Cache-Control'] as string);
---

<ExamLayout
  title={lang === 'hi' ? 'केंद्रीय / राष्ट्रीय भर्तियाँ' : 'National & Central Government Exams'}
  description="Track SSC, UPSC, IBPS, RRB, NTA and other all-India recruitment updates with official links."
  theme={theme}
  lang={lang}
>
  <div class="bg-white rounded-lg shadow p-5 sm:p-6">
    <h1 class="text-2xl font-black text-slate-900 mb-2">{lang === 'hi' ? 'राष्ट्रीय परीक्षाएँ' : 'National / Central Jobs'}</h1>
    <p class="text-sm text-gray-600 mb-6 leading-relaxed">
      Central recruiting boards including SSC, UPSC, Railway RRBs, IBPS and NTA. Always open the official .gov.in / board link before applying.
    </p>
    <ul class="divide-y">
      {posts.map((p) => (
        <li class="py-3">
          <a href={`/exam/${p.slug}?lang=${lang}`} class="font-bold text-sm text-slate-900 hover:text-amber-700">
            {pickLang(p.title, p.title_hi, lang)}
          </a>
          <p class="text-xs text-gray-500 mt-1">{p.organization} · {p.category} · Last date {p.closing_date}</p>
        </li>
      ))}
    </ul>
  </div>
</ExamLayout>
