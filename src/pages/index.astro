---
import ExamLayout from '../layouts/ExamLayout.astro';
import { getDb } from '../lib/posts';
import { loadPublished } from '../lib/load';
import { getThemeSettings, cacheHeaders } from '../lib/settings';
import { DEFAULT_THEME } from '../lib/types';
import { getLang } from '../lib/i18n';

export const prerender = false;

const db = getDb(Astro.locals);
const theme = db ? await getThemeSettings(db) : DEFAULT_THEME;
const lang = getLang(Astro.url, Astro.request.headers.get('cookie'));
const examsData = await loadPublished(db);

const latestJobs = examsData.filter((i) => i.category === 'latest-jobs');
const admitCards = examsData.filter((i) => i.category === 'admit-cards');
const results = examsData.filter((i) => i.category === 'results' || i.category === 'answer-keys');
const allQualifications = [...new Set(examsData.flatMap((exam) => exam.qualifications || []))].sort();

Astro.response.headers.set('Cache-Control', cacheHeaders(theme.cacheTtlSeconds)['Cache-Control'] as string);
---

<ExamLayout
  title={lang === 'hi' ? 'एग्जाम स्टेटस डैशबोर्ड' : 'Exam Status & Sarkari Job Portal'}
  description="Live exam status dashboard for SSC, UPSC, Railway, Banking and State PSC updates."
  theme={theme}
  lang={lang}
>
  <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-5 sm:p-6 rounded-lg shadow-lg mb-6 text-center border-b-4" style={`border-color:${theme.colorAccent}`}>
    <h1 class="text-2xl md:text-4xl font-black uppercase tracking-tight text-amber-400">
      {lang === 'hi' ? 'अखिल भारतीय सरकारी परीक्षा डैशबोर्ड' : 'All India Sarkari Result Dashboard'}
    </h1>
    <p class="text-sm text-gray-300 mt-2 max-w-xl mx-auto">
      {lang === 'hi'
        ? 'SSC, UPSC, रेलवे, बैंकिंग और राज्य PSC की जाँची हुई अपडेट।'
        : 'Instant verified updates for SSC, UPSC, Railway, Banking, Teaching, Defense & State PSC.'}
    </p>

    <div class="mt-6 bg-slate-800/80 p-4 rounded border border-slate-700">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Smart Eligibility Filter</h3>
        <button type="button" id="reset-filters" class="text-[10px] uppercase font-bold text-amber-400 hover:underline min-h-[32px]">Reset</button>
      </div>
      <div class="flex flex-wrap justify-center gap-2" id="qualification-filters">
        <button data-qual="all" class="filter-btn active bg-amber-500 text-slate-900 px-4 py-2 rounded-full text-xs font-bold uppercase transition min-h-[40px]">
          All
        </button>
        {allQualifications.map((qual) => (
          <button data-qual={qual} class="filter-btn bg-slate-700 text-white px-4 py-2 rounded-full text-xs font-bold uppercase transition min-h-[40px]">
            {qual}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="dashboard-grid">
    <section class="bg-white border-2 border-red-600 rounded-lg shadow-md overflow-hidden flex flex-col result-col" id="results">
      <div class="bg-red-700 text-white font-black text-center py-3 px-3 uppercase text-sm flex justify-between items-center">
        <span>{theme.columnResults}</span>
        <span class="text-xs bg-red-950 px-2.5 py-1 rounded-full count-badge">{results.length}</span>
      </div>
      <div class="p-3 flex-grow space-y-2" id="results-list">
        {results.map((item) => (
          <a href={`/exam/${item.slug}?lang=${lang}`} class="exam-card block hover:bg-red-50 p-2 rounded transition" data-quals={JSON.stringify(item.qualifications || [])}>
            <div class="text-xs font-bold text-red-900 leading-snug">• {lang === 'hi' && item.title_hi ? item.title_hi : item.title}</div>
            <div class="text-[10px] text-gray-500 mt-1.5 flex justify-between gap-2">
              <span class="font-semibold truncate">{item.organization}</span>
              <span class="text-red-600 font-bold bg-red-100 px-1.5 rounded shrink-0">{item.result_date}</span>
            </div>
          </a>
        ))}
        <div class="empty-state hidden text-center text-xs text-gray-400 py-6 font-semibold">No results match this qualification.</div>
      </div>
      <a href={`/category/results?lang=${lang}`} class="bg-gray-100 hover:bg-gray-200 text-center py-2.5 text-xs font-bold text-red-800 border-t min-h-[44px] flex items-center justify-center">View all</a>
    </section>

    <section class="bg-white border-2 border-blue-600 rounded-lg shadow-md overflow-hidden flex flex-col admit-col" id="admit-cards">
      <div class="bg-blue-800 text-white font-black text-center py-3 px-3 uppercase text-sm flex justify-between items-center">
        <span>{theme.columnAdmitCards}</span>
        <span class="text-xs bg-blue-950 px-2.5 py-1 rounded-full count-badge">{admitCards.length}</span>
      </div>
      <div class="p-3 flex-grow space-y-2" id="admit-list">
        {admitCards.map((item) => (
          <a href={`/exam/${item.slug}?lang=${lang}`} class="exam-card block hover:bg-blue-50 p-2 rounded transition" data-quals={JSON.stringify(item.qualifications || [])}>
            <div class="text-xs font-bold text-blue-900 leading-snug">• {lang === 'hi' && item.title_hi ? item.title_hi : item.title}</div>
            <div class="text-[10px] text-gray-500 mt-1.5 flex justify-between gap-2">
              <span class="font-semibold truncate">{item.organization}</span>
              <span class="text-blue-600 font-bold bg-blue-100 px-1.5 rounded shrink-0">{item.admit_card_date}</span>
            </div>
          </a>
        ))}
        <div class="empty-state hidden text-center text-xs text-gray-400 py-6 font-semibold">No admit cards match.</div>
      </div>
      <a href={`/category/admit-cards?lang=${lang}`} class="bg-gray-100 hover:bg-gray-200 text-center py-2.5 text-xs font-bold text-blue-900 border-t min-h-[44px] flex items-center justify-center">View all</a>
    </section>

    <section class="bg-white border-2 border-green-700 rounded-lg shadow-md overflow-hidden flex flex-col jobs-col" id="latest-jobs">
      <div class="bg-green-800 text-white font-black text-center py-3 px-3 uppercase text-sm flex justify-between items-center">
        <span>{theme.columnLatestJobs}</span>
        <span class="text-xs bg-green-950 px-2.5 py-1 rounded-full count-badge">{latestJobs.length}</span>
      </div>
      <div class="p-3 flex-grow space-y-2" id="jobs-list">
        {latestJobs.map((item) => (
          <a href={`/exam/${item.slug}?lang=${lang}`} class="exam-card block hover:bg-green-50 p-2 rounded transition" data-quals={JSON.stringify(item.qualifications || [])}>
            <div class="text-xs font-bold text-gray-900 leading-snug">
              • {lang === 'hi' && item.title_hi ? item.title_hi : item.title}
              {item.total_vacancies > 0 && <span class="text-green-700"> ({item.total_vacancies})</span>}
            </div>
            <div class="text-[10px] text-gray-500 mt-1.5 flex justify-between gap-2">
              <span>Last: <strong class="text-red-600">{item.closing_date}</strong></span>
              <span class="bg-green-600 text-white font-bold px-2 py-0.5 rounded shrink-0">Apply</span>
            </div>
          </a>
        ))}
        <div class="empty-state hidden text-center text-xs text-gray-400 py-6 font-semibold">No jobs match.</div>
      </div>
      <a href={`/category/latest-jobs?lang=${lang}`} class="bg-gray-100 hover:bg-gray-200 text-center py-2.5 text-xs font-bold text-green-900 border-t min-h-[44px] flex items-center justify-center">View all</a>
    </section>
  </div>

  <script is:inline>
    (function () {
      const KEY = 'examstatus_qual';
      const filterBtns = document.querySelectorAll('.filter-btn');
      const allCards = document.querySelectorAll('.exam-card');
      const columns = [
        { id: 'results-list', badge: '.result-col .count-badge' },
        { id: 'admit-list', badge: '.admit-col .count-badge' },
        { id: 'jobs-list', badge: '.jobs-col .count-badge' }
      ];

      function applyQual(selectedQual) {
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-amber-500', 'text-slate-900');
          b.classList.add('bg-slate-700', 'text-white');
        });
        const active = Array.from(filterBtns).find((b) => b.getAttribute('data-qual') === selectedQual) || filterBtns[0];
        active.classList.remove('bg-slate-700', 'text-white');
        active.classList.add('active', 'bg-amber-500', 'text-slate-900');

        allCards.forEach((card) => {
          let matched = selectedQual === 'all';
          if (!matched) {
            try {
              matched = JSON.parse(card.getAttribute('data-quals') || '[]').includes(selectedQual);
            } catch (e) {}
          }
          card.style.display = matched ? 'block' : 'none';
        });

        columns.forEach((col) => {
          const listEl = document.getElementById(col.id);
          if (!listEl) return;
          const badgeEl = document.querySelector(col.badge);
          const emptyState = listEl.querySelector('.empty-state');
          const count = Array.from(listEl.querySelectorAll('.exam-card')).filter((c) => c.style.display !== 'none').length;
          if (badgeEl) badgeEl.textContent = String(count);
          if (emptyState) {
            emptyState.classList.toggle('hidden', count !== 0);
          }
        });
        try { localStorage.setItem(KEY, selectedQual); } catch (e) {}
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => applyQual(btn.getAttribute('data-qual') || 'all'));
      });
      document.getElementById('reset-filters')?.addEventListener('click', () => applyQual('all'));

      let saved = 'all';
      try { saved = localStorage.getItem(KEY) || 'all'; } catch (e) {}
      applyQual(saved);
    })();
  </script>
</ExamLayout>
