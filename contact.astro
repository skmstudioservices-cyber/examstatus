---
import ExamLayout from '../layouts/ExamLayout.astro';
---

<ExamLayout
  title="Contact Us"
  description="Get in touch with ExamStatus to report an error, request a feature, or share feedback."
>
  <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl mx-auto text-center">
    <h1 class="text-2xl font-black text-slate-900 mb-4">Contact Us</h1>
    <p class="text-sm text-gray-700 mb-6 leading-relaxed">
      Spotted an outdated date, a wrong link, or a missing exam? Want us to cover a state or exam category
      we don't have yet? The fastest way to reach us is the <strong>Feedback</strong> button in the bottom-right
      corner of any page on this site — every message goes directly to the team maintaining ExamStatus.
    </p>
    <p class="text-sm text-gray-700 leading-relaxed">
      For exam corrections specifically, please mention the exam name and what needs fixing so we can verify
      and update it quickly.
    </p>
  </div>
</ExamLayout>
