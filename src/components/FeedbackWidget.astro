<button
  id="fb-open-btn"
  aria-label="Send feedback or request a feature"
  class="fixed bottom-5 right-5 z-40 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs px-4 py-3 rounded-full shadow-lg flex items-center gap-2 transition-transform hover:scale-105"
>
  💬 Feedback
</button>

<div id="fb-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-sm p-5">
    <div class="flex justify-between items-center mb-3">
      <div>
        <h3 class="font-black text-slate-900 text-sm">Audience Feedback & Suggestions</h3>
        <p class="text-[11px] text-gray-500">Help us improve ExamStatus or request new exams</p>
      </div>
      <button id="fb-close-btn" aria-label="Close" class="text-gray-400 hover:text-gray-700 text-xl font-bold leading-none">&times;</button>
    </div>
    <form id="fb-form" class="space-y-3">
      <div>
        <label class="block text-[11px] font-bold text-gray-700 mb-1">What would you like to share?</label>
        <select id="fb-type" class="w-full border border-gray-300 rounded p-1.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
          <option value="exam-request">📌 Request New Exam / Job to Cover</option>
          <option value="feedback">💬 Site Experience & Feedback</option>
          <option value="feature">💡 Feature or Improvement Suggestion</option>
          <option value="correction">⚠️ Report Wrong Date / Broken Link</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-bold text-gray-700 mb-1">Details</label>
        <textarea id="fb-message" required minlength="3" maxlength="2000" rows="3" placeholder="Tell us which exam/job or how we can make the site better for you..." class="w-full border border-gray-300 rounded p-2 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
      </div>
      <div>
        <label class="block text-[11px] font-bold text-gray-700 mb-1">Email / Phone / Telegram (Optional)</label>
        <input id="fb-contact" type="text" maxlength="200" placeholder="So we can notify you when covered" class="w-full border border-gray-300 rounded p-2 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500" />
      </div>
      <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs py-2.5 rounded shadow transition-colors flex items-center justify-center gap-1">
        <span>Submit Feedback</span>
      </button>
      <p id="fb-status" class="text-xs text-center min-h-[1rem]"></p>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    const openBtn = document.getElementById('fb-open-btn');
    const closeBtn = document.getElementById('fb-close-btn');
    const modal = document.getElementById('fb-modal');
    const form = document.getElementById('fb-form');
    const status = document.getElementById('fb-status');

    openBtn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });
    closeBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = document.getElementById('fb-message').value;
      const contact = document.getElementById('fb-contact').value;
      const typeSelect = document.getElementById('fb-type');
      const type = typeSelect ? typeSelect.value : 'feedback';
      status.textContent = 'Sending...';
      status.className = 'text-xs text-center min-h-[1rem] text-gray-500';
      try {
        const res = await fetch('/api/feedback.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, contact, type, pathname: window.location.pathname })
        });
        const data = await res.json();
        if (res.ok) {
          status.textContent = data.message || 'Thanks! Your feedback has been received.';
          status.className = 'text-xs text-center min-h-[1rem] text-green-600 font-bold';
          form.reset();
          setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            status.textContent = '';
          }, 2000);
        } else {
          status.textContent = data.error || 'Something went wrong, try again.';
          status.className = 'text-xs text-center min-h-[1rem] text-red-600 font-semibold';
        }
      } catch (err) {
        status.textContent = 'Network error, please try again.';
        status.className = 'text-xs text-center min-h-[1rem] text-red-600 font-semibold';
      }
    });
  })();
</script>
