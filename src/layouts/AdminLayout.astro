---
export const prerender = false;

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  user: { email: string; role: string };
  title?: string;
  breadcrumbs?: Breadcrumb[];
}

const { user, title, breadcrumbs = [] } = Astro.props;
const path = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'dash', match: (p: string) => p === '/admin' },
  { href: '/admin/posts', label: 'Posts', icon: 'posts', match: (p: string) => p.startsWith('/admin/posts') },
  { href: '/admin/theme', label: 'Theme', icon: 'theme', match: (p: string) => p.startsWith('/admin/theme') },
  { href: '/admin/ai', label: 'AI Inbox', icon: 'ai', match: (p: string) => p.startsWith('/admin/ai') },
  { href: '/admin/team', label: 'Team', icon: 'team', match: (p: string) => p.startsWith('/admin/team') },
  { href: '/admin/audit', label: 'Audit', icon: 'audit', match: (p: string) => p.startsWith('/admin/audit') },
];

function navClass(active: boolean) {
  return active
    ? 'bg-slate-700 text-white border-l-amber-400'
    : 'text-slate-300 hover:bg-slate-700/60 hover:text-white border-l-transparent';
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} · ExamStatus Admin` : 'ExamStatus Admin'}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media (max-width: 767px) {
      #admin-sidebar.open { transform: translateX(0); }
      #admin-overlay.open { display: block; }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen">
  <div class="flex min-h-screen">
    <!-- Mobile overlay -->
    <div id="admin-overlay" class="fixed inset-0 z-30 hidden bg-black/40 md:hidden" aria-hidden="true"></div>

    <!-- Sidebar -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-40 flex w-56 -translate-x-full flex-col bg-slate-800 text-white transition-transform md:static md:translate-x-0"
    >
      <div class="flex items-center gap-2 border-b border-slate-700 px-4 py-4">
        <span class="text-lg font-black tracking-tight text-amber-400">ExamStatus</span>
      </div>
      <nav class="flex-1 overflow-y-auto py-2" aria-label="Admin navigation">
        {navItems.map((item) => {
          const active = item.match(path);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 border-l-4 px-4 py-2.5 text-sm font-semibold transition-colors ${navClass(active)}`}
            >
              {item.icon === 'dash' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
              )}
              {item.icon === 'posts' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              )}
              {item.icon === 'theme' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
              )}
              {item.icon === 'ai' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
              )}
              {item.icon === 'team' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              )}
              {item.icon === 'audit' && (
                <svg class="h-4 w-4 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
              )}
              {item.label}
            </a>
          );
        })}
      </nav>
      <div class="border-t border-slate-700 p-3 text-[10px] text-slate-400">
        CMS · Astro + D1
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-w-0 flex-1 flex-col">
      <!-- Top bar -->
      <header class="sticky top-0 z-20 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white px-4 py-2.5 shadow-sm">
        <div class="flex items-center gap-3">
          <button
            id="sidebar-toggle"
            type="button"
            class="rounded p-1.5 text-slate-600 hover:bg-slate-100 md:hidden"
            aria-label="Toggle menu"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <a href="/" target="_blank" rel="noopener" class="text-xs font-bold text-amber-600 hover:text-amber-700">
            View site ↗
          </a>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <span class="hidden text-slate-500 sm:inline">{user.email}</span>
          <span class="rounded bg-slate-100 px-2 py-0.5 font-bold uppercase text-slate-600">{user.role}</span>
          <button id="logout-btn" type="button" class="font-bold text-red-600 hover:text-red-700">Logout</button>
        </div>
      </header>

      <!-- Content -->
      <main class="flex-1 p-4 md:p-6">
        {breadcrumbs.length > 0 && (
          <nav class="mb-3 text-xs text-slate-500" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-1">
              <li><a href="/admin" class="hover:text-amber-600">Dashboard</a></li>
              {breadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-1">
                  <span aria-hidden="true">/</span>
                  {crumb.href && i < breadcrumbs.length - 1 ? (
                    <a href={crumb.href} class="hover:text-amber-600">{crumb.label}</a>
                  ) : (
                    <span class="font-semibold text-slate-700">{crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('admin-overlay');
    const toggle = document.getElementById('sidebar-toggle');

    function closeSidebar() {
      sidebar?.classList.remove('open');
      overlay?.classList.remove('open');
    }
    function openSidebar() {
      sidebar?.classList.add('open');
      overlay?.classList.add('open');
    }

    toggle?.addEventListener('click', () => {
      if (sidebar?.classList.contains('open')) closeSidebar();
      else openSidebar();
    });
    overlay?.addEventListener('click', closeSidebar);

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/auth.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'logout' })
      });
      location.href = '/admin/login';
    });
  </script>
</body>
</html>
