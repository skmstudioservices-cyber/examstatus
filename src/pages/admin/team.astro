---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HelpTip from '../../components/admin/HelpTip.astro';
import { getDb } from '../../lib/posts';
import { parseCookies, resolveAdmin, canManageUsers, listAdminUsers } from '../../lib/auth';

export const prerender = false;

const db = getDb(Astro.locals);
if (!db) return Astro.redirect('/admin/login');
const cookies = parseCookies(Astro.request.headers.get('cookie'));
const user = await resolveAdmin(db, Astro.request, cookies['examstatus_session']);
if (!user || !canManageUsers(user.role)) return Astro.redirect('/admin');
const users = await listAdminUsers(db);
---

<AdminLayout user={user} title="Team" breadcrumbs={[{ label: 'Team' }]}>
  <h1 class="mb-2 flex items-center text-2xl font-black">
    Team & roles
    <HelpTip text="Owner: full access including theme and team. Editor: posts and publish. Researcher: AI inbox only." />
  </h1>
  <p class="mb-4 text-xs text-gray-600">Map emails to owner / editor / researcher. For Cloudflare Access, invite the same emails in Zero Trust and protect <code>/admin*</code>.</p>

  <section class="mb-6 rounded-lg border border-slate-200 bg-white shadow-sm">
    <h2 class="flex items-center border-b px-3 py-2 text-sm font-bold">
      Current members
      <HelpTip text="Roles are enforced on every admin page. Match emails with Cloudflare Access policies." />
    </h2>
    <ul class="divide-y">
      {users.map((u: any) => (
        <li class="flex justify-between px-3 py-2 text-sm">
          <span>{u.email}</span>
          <span class="flex items-center text-xs font-bold uppercase">
            {u.role}
            {u.role === 'owner' && <HelpTip text="Full CMS access: theme, team, posts, AI, audit." />}
            {u.role === 'editor' && <HelpTip text="Can create, edit, and publish posts. No theme or team changes." />}
            {u.role === 'researcher' && <HelpTip text="Can run research and manage AI Inbox drafts. Cannot publish posts directly." />}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <form id="add-user" class="max-w-md space-y-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
    <h2 class="text-sm font-bold">Add or update member</h2>
    <input name="email" type="email" required placeholder="colleague@email.com" class="w-full rounded border px-2 py-2 text-sm" />
    <label class="block text-xs font-bold">
      <span class="flex items-center">Role<HelpTip text="Choose the least privilege needed. Owner is required for at least one person." /></span>
      <select name="role" class="mt-1 w-full rounded border px-2 py-2 text-sm">
        <option value="editor">Editor</option>
        <option value="researcher">Researcher</option>
        <option value="owner">Owner</option>
      </select>
    </label>
    <input name="password" type="password" minlength="10" placeholder="Optional password (10+) for non-Access login" class="w-full rounded border px-2 py-2 text-sm" />
    <button class="rounded bg-amber-500 px-4 py-2 text-sm font-bold hover:bg-amber-600">Add / update</button>
    <p id="team-msg" class="text-xs"></p>
  </form>

  <div class="mt-6 space-y-2 rounded-lg border bg-slate-50 p-4 text-xs">
    <p class="font-bold">Cloudflare Access invite flow</p>
    <ol class="list-decimal space-y-1 pl-5">
      <li>Cloudflare Dashboard → Zero Trust → Access → Applications → Self-hosted</li>
      <li>Protect path <code>examstatus.../admin*</code> and <code>/api/admin*</code></li>
      <li>Policy: allow emails / Access groups matching Team emails here</li>
      <li>First Access login auto-promotes to owner if no users exist</li>
    </ol>
  </div>
  <script is:inline>
    document.getElementById('add-user').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target;
      const res = await fetch('/api/admin/auth.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add_user', email: f.email.value, role: f.role.value, password: f.password.value || undefined })
      });
      const data = await res.json();
      document.getElementById('team-msg').textContent = res.ok ? 'Saved' : (data.error || 'Failed');
      if (res.ok) location.reload();
    });
  </script>
</AdminLayout>
