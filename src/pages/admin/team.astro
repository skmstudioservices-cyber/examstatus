---
import AdminLayout from '../../layouts/AdminLayout.astro';
import HelpTip from '../../components/admin/HelpTip.astro';
import { getDb } from '../../lib/posts';
import { parseCookies, resolveAdmin, canManageUsers, listAdminUsers } from '../../lib/auth';

export const prerender = false;

const db = getDb(Astro.locals);
if (!db) return Astro.redirect('/admin/login');
const cookies = parseCookies(Astro.request.headers.get('cookie'));
const user = await resolveAdmin(db, Astro.request, cookies['examstatus_session']);
if (!user || !canManageUsers(user.role)) return Astro.redirect('/admin');
const users = await listAdminUsers(db);
---

<AdminLayout user={user} title="Users" breadcrumbs={[{ label: 'Users' }]}>
  <div class="mb-4">
    <h1 class="flex items-center text-xl font-bold text-[#1d2327]">
      Users & Roles
      <HelpTip text="Owner: full access including theme and team. Editor: posts and publish. Researcher: AI inbox only." />
    </h1>
    <p class="text-xs text-slate-500 mt-0.5">Map emails to owner / editor / researcher roles.</p>
  </div>

  <section class="mb-6 rounded border border-[#c3c4c7] bg-white shadow-sm overflow-hidden">
    <div class="border-b border-[#c3c4c7] bg-[#f6f7f7] px-4 py-2.5">
      <h2 class="flex items-center text-xs font-bold text-[#1d2327]">
        All Users ({users.length})
        <HelpTip text="Roles are enforced on every admin page. Match emails with Cloudflare Access policies." />
      </h2>
    </div>
    <ul class="divide-y divide-slate-100">
      {users.map((u: any) => (
        <li class="flex items-center justify-between px-4 py-2.5 text-xs">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-[11px]">
              {u.email.charAt(0).toUpperCase()}
            </div>
            <span class="font-semibold text-slate-800">{u.email}</span>
          </div>
          <span class="flex items-center text-[10px] font-bold uppercase rounded px-2 py-0.5 bg-slate-100 text-slate-700">
            {u.role}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <form id="add-user" class="max-w-md space-y-3 rounded border border-[#c3c4c7] bg-white p-4 shadow-sm">
    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Add New User</h2>
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
      <input name="email" type="email" required placeholder="colleague@email.com" class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none" />
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">
        <span class="flex items-center">Role<HelpTip text="Choose the least privilege needed. Owner is required for at least one person." /></span>
      </label>
      <select name="role" class="w-full rounded border border-slate-300 px-2 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none">
        <option value="editor">Editor</option>
        <option value="researcher">Researcher</option>
        <option value="owner">Owner</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
      <input name="password" type="password" minlength="10" placeholder="Optional password (10+) for direct login" class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs focus:border-[#2271b1] focus:outline-none" />
    </div>
    <button class="rounded bg-[#2271b1] px-4 py-1.5 text-xs font-bold text-white hover:bg-[#135e96] transition shadow-sm">Add / Update User</button>
    <p id="team-msg" class="text-xs font-semibold"></p>
  </form>

  <div class="mt-6 space-y-2 rounded-lg border bg-slate-50 p-4 text-xs">
    <p class="font-bold">Cloudflare Access invite flow</p>
    <ol class="list-decimal space-y-1 pl-5">
      <li>Cloudflare Dashboard → Zero Trust → Access → Applications → Self-hosted</li>
      <li>Protect path <code>examstatus.../admin*</code> and <code>/api/admin*</code></li>
      <li>Policy: allow emails / Access groups matching Team emails here</li>
      <li>First Access login auto-promotes to owner if no users exist</li>
    </ol>
  </div>
  <script is:inline>
    document.getElementById('add-user').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target;
      const res = await fetch('/api/admin/auth.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add_user', email: f.email.value, role: f.role.value, password: f.password.value || undefined })
      });
      const data = await res.json();
      document.getElementById('team-msg').textContent = res.ok ? 'Saved' : (data.error || 'Failed');
      if (res.ok) location.reload();
    });
  </script>
</AdminLayout>
