---
import type { Post } from '../lib/types';

interface Props {
  post: Post;
  telegramUrl?: string;
}

const { post, telegramUrl = 'https://telegram.org' } = Astro.props;
const apply = post.apply_online_url || post.official_url || '#';
const pdf = post.notification_pdf_url || post.official_url || '#';
const official = post.official_url || '#';
---

<div class="border-2 border-red-700 bg-white rounded-lg shadow-md overflow-hidden text-sm my-6">
  <div class="bg-red-800 text-white p-4 text-center">
    <h2 class="text-xl md:text-2xl font-black uppercase tracking-tight break-words">{post.organization}</h2>
    <p class="text-amber-300 font-bold text-base md:text-lg mt-1 break-words">{post.post_name}</p>
    {post.total_vacancies > 0 && (
      <div class="inline-block bg-amber-500 text-slate-950 font-black px-4 py-1 rounded-full text-xs uppercase mt-2 shadow">
        Total Vacancies: {post.total_vacancies} Posts
      </div>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-red-200 bg-red-50">
    <div class="p-3 sm:p-4">
      <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
        Important Dates
      </h3>
      <ul class="space-y-2 text-xs sm:text-sm">
        <li class="flex justify-between gap-2 py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Application Start</span>
          <span class="font-bold text-green-700 text-right">{post.start_date}</span>
        </li>
        <li class="flex justify-between gap-2 py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Last Date</span>
          <span class="font-bold text-red-700 text-right">{post.closing_date}</span>
        </li>
        <li class="flex justify-between gap-2 py-1 border-b border-red-100">
          <span class="font-semibold text-gray-700">Exam Date</span>
          <span class="font-bold text-blue-800 text-right">{post.exam_date}</span>
        </li>
        <li class="flex justify-between gap-2 py-1">
          <span class="font-semibold text-gray-700">Admit Card</span>
          <span class="font-bold text-purple-700 text-right">{post.admit_card_date}</span>
        </li>
      </ul>
    </div>

    <div class="p-3 sm:p-4">
      <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
        Application Fee
      </h3>
      <ul class="space-y-2 text-xs sm:text-sm">
        {(post.fees || []).map((f) => (
          <li class="flex justify-between gap-2 py-1 border-b border-red-100">
            <span class="font-semibold text-gray-700">{f.category}</span>
            <span class="font-bold text-gray-900 text-right">{f.amount}</span>
          </li>
        ))}
      </ul>
      <div class="mt-3 p-2 bg-white rounded border border-red-200 text-xs text-gray-600">
        <strong class="text-red-700">Payment:</strong> Online via Net Banking, Debit Card, UPI
      </div>
    </div>
  </div>

  <div class="p-3 sm:p-4 border-t-2 border-red-200 bg-white">
    <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-2 uppercase text-center bg-red-100 py-1 text-xs">
      Age Limit
    </h3>
    <div class="flex flex-wrap justify-around gap-2 text-xs sm:text-sm font-semibold py-1 text-gray-800">
      <div>Min: <span class="text-red-700 font-bold">{post.min_age}</span></div>
      <div>Max: <span class="text-red-700 font-bold">{post.max_age}</span></div>
    </div>
  </div>

  {(post.eligibility || []).length > 0 && (
    <div class="p-3 sm:p-4 border-t-2 border-red-200 bg-gray-50">
      <h3 class="font-extrabold text-red-900 border-b-2 border-red-600 pb-1 mb-3 uppercase text-center bg-red-100 py-1 text-xs">
        Vacancy & Eligibility
      </h3>
      <div class="overflow-x-auto -mx-1 px-1 shadow-[inset_-12px_0_12px_-12px_rgba(0,0,0,0.15)]">
        <table class="w-full min-w-[480px] text-left border-collapse border border-gray-300 text-xs sm:text-sm">
          <thead>
            <tr class="bg-red-800 text-white font-bold">
              <th class="p-2 border border-gray-300">Post Name</th>
              <th class="p-2 border border-gray-300 text-center">Posts</th>
              <th class="p-2 border border-gray-300">Qualification</th>
            </tr>
          </thead>
          <tbody>
            {post.eligibility.map((item, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-red-50/50'}>
                <td class="p-2 border border-gray-300 font-bold text-gray-800">{item.postName}</td>
                <td class="p-2 border border-gray-300 text-center font-extrabold text-red-700">{item.totalPosts}</td>
                <td class="p-2 border border-gray-300 text-gray-700">{item.qualification}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="sm:hidden mt-3 space-y-2">
        {post.eligibility.map((item) => (
          <div class="bg-white border border-red-200 rounded p-3 text-xs">
            <p class="font-bold text-gray-900">{item.postName}</p>
            <p class="text-red-700 font-extrabold mt-1">{item.totalPosts} posts</p>
            <p class="text-gray-600 mt-1">{item.qualification}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="p-3 sm:p-4 border-t-4 border-red-600 bg-amber-50">
    <h3 class="font-black text-slate-900 text-sm md:text-base text-center uppercase mb-3">
      Important Links
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-center font-bold text-xs md:text-sm">
      <a href={apply} target="_blank" rel="noopener noreferrer" class="min-h-[44px] flex items-center justify-center bg-green-700 hover:bg-green-800 text-white py-3 px-4 rounded shadow">
        Apply Online
      </a>
      <a href={pdf} target="_blank" rel="noopener noreferrer" class="min-h-[44px] flex items-center justify-center bg-red-700 hover:bg-red-800 text-white py-3 px-4 rounded shadow">
        Notification PDF
      </a>
      <a href={official} target="_blank" rel="noopener noreferrer" class="min-h-[44px] flex items-center justify-center bg-blue-700 hover:bg-blue-800 text-white py-3 px-4 rounded shadow">
        Official Website
      </a>
      <a href={telegramUrl} target="_blank" rel="noopener noreferrer" class="min-h-[44px] flex items-center justify-center bg-sky-600 hover:bg-sky-700 text-white py-3 px-4 rounded shadow">
        Telegram Alerts
      </a>
    </div>
  </div>
</div>

{/* Mobile sticky CTAs */}
<div class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-slate-950/95 backdrop-blur border-t border-slate-700 px-2 py-2 flex gap-2 safe-pb">
  <a href={apply} target="_blank" rel="noopener noreferrer" class="flex-1 min-h-[44px] flex items-center justify-center bg-green-600 text-white text-xs font-black rounded">Apply</a>
  <a href={pdf} target="_blank" rel="noopener noreferrer" class="flex-1 min-h-[44px] flex items-center justify-center bg-red-600 text-white text-xs font-black rounded">PDF</a>
  <a href={official} target="_blank" rel="noopener noreferrer" class="flex-1 min-h-[44px] flex items-center justify-center bg-blue-600 text-white text-xs font-black rounded">Official</a>
</div>
